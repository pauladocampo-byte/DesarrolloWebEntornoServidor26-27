@model List<string>

@{
    ViewData["Title"] = "Mostrar productos";
}

<h1 class="mt-4 mb-3">Productos almacenados en sesión</h1>

@if (Model == null || Model.Count == 0)
{
    <p class="text-muted">No hay productos en la variable de sesión.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Producto</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>@(i + 1)</td>
                    <td>@Model[i]</td>
                    <td>
                        <a asp-action="EliminarProducto"
                           asp-route-index="@i"
                           class="btn btn-sm btn-danger">
                            Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <form asp-action="VaciarProductos" method="post" class="mt-3">
        <button type="submit" class="btn btn-warning">
            Vaciar lista de productos
        </button>
    </form>
}

<p class="mt-3">
    <a asp-action="ListarProductos" class="btn btn-outline-secondary">
        Volver a "Listar productos"
    </a>
</p>
