@model Actividad5.Models.PedidoBind

@{
    ViewData["Title"] = "Editar pedido (Bind lista)";
}

<h1 class="mt-4 mb-3">Editar pedido</h1>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <form asp-action="EditarPedido" method="post">
                    <div class="mb-3">
                        <label asp-for="Cliente" class="form-label"></label>
                        <input asp-for="Cliente" class="form-control" />
                    </div>

                    <hr />
                    <h5>Productos</h5>

                    @for (int i = 0; i < Model.Productos.Count; i++)
                    {
                        <div class="row g-3 align-items-end mb-2">
                            <div class="col-md-6">
                                <label asp-for="Productos[i].Nombre" class="form-label">
                                    Producto @(@i + 1)
                                </label>
                                <input asp-for="Productos[i].Nombre" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Productos[i].Precio" class="form-label"></label>
                                <input asp-for="Productos[i].Precio" class="form-control" />
                            </div>
                        </div>
                    }

                    <button type="submit" class="btn btn-primary mt-3">Guardar pedido</button>
                </form>
            </div>
        </div>
    </div>
</div>
