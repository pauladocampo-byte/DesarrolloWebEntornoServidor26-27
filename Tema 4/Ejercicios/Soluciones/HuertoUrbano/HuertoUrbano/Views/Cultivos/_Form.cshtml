@model HuertoUrbano.Models.Cultivo
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3">
    <label asp-for="Nombre"></label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Variedad"></label>
    <input asp-for="Variedad" class="form-control" />
    <span asp-validation-for="Variedad" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="FechaSiembra"></label>
    <input asp-for="FechaSiembra" class="form-control" />
    <span asp-validation-for="FechaSiembra" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="SuperficieM2"></label>
    <input asp-for="SuperficieM2" class="form-control" />
    <span asp-validation-for="SuperficieM2" class="text-danger"></span>
</div>
<div class="form-check">
    <input asp-for="EnProduccion" class="form-check-input" />
    <label asp-for="EnProduccion"></label>
</div>
