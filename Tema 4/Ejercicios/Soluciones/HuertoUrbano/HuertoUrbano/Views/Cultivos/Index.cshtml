@model IEnumerable<HuertoUrbano.Models.Cultivo>
<h1>Cultivos</h1>
<p>
    <a asp-action="Create">Añadir nuevo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Variedad</th>
            <th>FechaSiembra</th>
            <th>SuperficieM2</th>
            <th>EnProduccion</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.Nombre</td>
                <td>@x.Variedad</td>
                <td>@x.FechaSiembra</td>
                <td>@x.SuperficieM2</td>
                <td>@x.EnProduccion</td>
                <td>
                    <a asp-action="Details" asp-route-id="@x.Id">Ver</a> |
                    <a asp-action="Edit" asp-route-id="@x.Id">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@x.Id">Borrar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
