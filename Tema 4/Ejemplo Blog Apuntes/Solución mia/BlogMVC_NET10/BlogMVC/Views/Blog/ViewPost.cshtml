@model Post
@{
    ViewData["Title"] = Model.Titulo;
}

<article class="article-detail">
    <a class="back-link" asp-action="Index">← Volver a las publicaciones</a>
    <p class="post-date">@Model.FechaPublicacion.ToString("d 'de' MMMM 'de' yyyy", System.Globalization.CultureInfo.GetCultureInfo("es-ES"))</p>
    <h1>@Model.Titulo</h1>
    <div class="article-copy">@Model.Texto</div>
</article>
