@model IEnumerable<Post>
@{
    ViewData["Title"] = "Últimas publicaciones";
}

<section class="hero">
    <p class="eyebrow">BLOG DEL AULA</p>
    <h1>Últimas publicaciones</h1>
    <p>Las entradas más recientes, ordenadas por fecha.</p>
</section>

@if (!Model.Any())
{
    <div class="empty-state">Todavía no hay publicaciones para mostrar.</div>
}
else
{
    <section class="post-grid" aria-label="Publicaciones recientes">
        @foreach (var post in Model)
        {
            <article class="post-card">
                <p class="post-date">@post.FechaPublicacion.ToString("d 'de' MMMM 'de' yyyy", System.Globalization.CultureInfo.GetCultureInfo("es-ES"))</p>
                <h2>@post.Titulo</h2>
                <p class="excerpt">@(post.Texto.Length > 150 ? post.Texto[..150] + "…" : post.Texto)</p>
                <a class="text-link" asp-action="ViewPost" asp-route-codigo="@post.PostId">Leer artículo <span aria-hidden="true">→</span></a>U
            </article>
        }
    </section>
}
