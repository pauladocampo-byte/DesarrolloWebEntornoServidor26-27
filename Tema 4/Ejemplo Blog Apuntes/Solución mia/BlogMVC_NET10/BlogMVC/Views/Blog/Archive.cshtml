@model IEnumerable<Post>
@{
    ViewData["Title"] = "Archivo";
}

<section class="hero">
    <p class="eyebrow">ARCHIVO</p>
    <h1>Publicaciones de @ViewBag.Periodo</h1>
    <p>Estas entradas se han filtrado usando el año y el mes de su fecha.</p>
</section>

@if (!Model.Any())
{
    <div class="empty-state">No hay publicaciones para este periodo.</div>
}
else
{
    <section class="post-grid" aria-label="Publicaciones del periodo">
        @foreach (var post in Model)
        {
            <article class="post-card">
                <p class="post-date">@post.FechaPublicacion.ToString("d 'de' MMMM 'de' yyyy", System.Globalization.CultureInfo.GetCultureInfo("es-ES"))</p>
                <h2>@post.Titulo</h2>
                <p class="excerpt">@post.Texto</p>
                <a class="text-link" asp-action="ViewPost" asp-route-codigo="@post.PostId">Leer artículo <span aria-hidden="true">→</span></a>
            </article>
        }
    </section>
}
