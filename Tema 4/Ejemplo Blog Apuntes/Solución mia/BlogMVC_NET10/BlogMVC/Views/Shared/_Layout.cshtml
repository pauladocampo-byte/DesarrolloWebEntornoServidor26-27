<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Blog del aula</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-controller="Blog" asp-action="Index">Blog del aula</a>
        <nav aria-label="Navegación principal">
            <a asp-controller="Blog" asp-action="Index">Inicio</a>
            <a href="/blog/archive/2025/3">Archivo de marzo de 2025</a>
        </nav>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer class="site-footer">Ejemplo didáctico de ASP.NET Core MVC y Entity Framework Core</footer>
</body>
</html>
