@model IEnumerable<MontecasteloAuthDemo.Models.Usuario>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<form method="get">
    <input type="search" name="q" placeholder="Buscar usuario..." value="@Context.Request.Query["q"]">
    <button  type="submit">Buscar</button>
    <a asp-action="Index">Limpiar</a>
</form>

<p>
    <a asp-action="Create">Nuevo usuario</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NombreUsuario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rol)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.NombreUsuario)
            </td>
            <td>
                @Html.DisplayFor(model => item.Rol)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> 
                <a asp-action="ResetPassword" asp-route-id="@item.Id">Reset pass</a>|
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
